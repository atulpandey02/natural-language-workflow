# NLW dataset retention sweep and receipt reconciliation — one-shot (O-5/O-6,
# ADR-035, ADR-038).
#
# DORMANT: install only with the separately authorized dataset enablement.
#
# Runs the retention commands in the one-shot `retention` service of
# docker-compose.datasets.yml and writes their textfile metrics
# (nlw_datasets_retention.prom, nlw_datasets_receipts.prom) for the dataset
# exporter. It runs as the unattended retention role nlw-<env>-dataset-retention
# (ADR-038; host-trusted, refreshed every 15 min by nlw-aws-credentials), never
# the human operator role; the application refuses every command but the
# sweep, its status and receipt reconciliation under that identity. A missing
# or expiring credential file fails the run closed, which
# NlwDatasetRetentionSweepFailed/Stale and NlwDatasetCredentialRefreshStale report.
[Unit]
Description=NLW dataset retention sweep (one-shot)
Documentation=file:/opt/nlw/docs/runbooks/dataset-staging-dormant.md
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/nlw/current
TimeoutStartSec=3600
# --no-deps: never recreate the running database container (see nlw-backup.service).
ExecStart=/usr/bin/docker compose -p app --env-file /opt/nlw/current/.env.prod \
    --env-file /opt/nlw/.env.datasets -f docker-compose.prod.yml \
    -f docker-compose.staging.yml -f docker-compose.datasets.yml --profile retention \
    run --rm --no-deps retention python -m nlw.ops.datasets retention-sweep \
    --operator retention-timer --metrics-file /var/lib/node_exporter/textfile/nlw_datasets_retention.prom
ExecStart=/usr/bin/docker compose -p app --env-file /opt/nlw/current/.env.prod \
    --env-file /opt/nlw/.env.datasets -f docker-compose.prod.yml \
    -f docker-compose.staging.yml -f docker-compose.datasets.yml --profile retention \
    run --rm --no-deps retention python -m nlw.ops.datasets reconcile-receipts \
    --metrics-file /var/lib/node_exporter/textfile/nlw_datasets_receipts.prom
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nlw-dataset-retention
