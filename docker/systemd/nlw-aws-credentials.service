# NLW per-container AWS credential refresher — one-shot (O-6, ADR-038).
#
# DORMANT: install only with the separately authorized dataset enablement
# (docs/runbooks/dataset-staging-dormant.md). Do NOT enable on a developer
# machine or on any host as part of this package.
#
# Assumes ONLY nlw-<env>-dataset-api and nlw-<env>-dataset-ingest with the host's
# own identity and writes /run/nlw/aws/<service>/credentials (tmpfs; dir 0700,
# file 0400, owned by the container uid). Never logs a credential value. The
# operator role (human trust) is never refreshed here. /etc/nlw/datasets.env
# (root, 0600) holds the two non-secret values NLW_AWS_ENV and NLW_AWS_ACCOUNT.
[Unit]
Description=NLW per-container AWS credential refresh (one-shot)
Documentation=file:/opt/nlw/docs/runbooks/dataset-staging-dormant.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/nlw/datasets.env
# Retries with backoff (5 s, 20 s, 60 s) are inside the script; a failed unit
# stays visible to the journal, and the expiry alert fires before any file ages out.
TimeoutStartSec=300
ExecStart=/usr/bin/python3 /opt/nlw/current/scripts/ops/nlw_aws_credential_refresh.py \
    --env ${NLW_AWS_ENV} --account ${NLW_AWS_ACCOUNT} --root /run/nlw/aws
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nlw-aws-credentials
