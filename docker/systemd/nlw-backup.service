# NLW encrypted off-host database backup — one-shot (M11.5 P2, ADR-022).
#
# Install to /etc/systemd/system/nlw-backup.service on the VPS. See
# docs/ops/backup-systemd.md and docs/runbooks/backup-operations.md. Do NOT enable
# on a developer machine.
#
# Single execution is enforced by an explicit flock the job takes around its whole
# lifecycle (shared backup_run volume -> /run/nlw/backup.lock); a second invocation
# exits 3 ("already running") having run no dump/upload/prune/metrics. Type=oneshot,
# the timer waiting for completion, and restic's repository lock are defense in
# depth (restic's lock alone does NOT prove single execution). The job exits
# non-zero on any failure, so a failed unit is visible to journald/alerting and the
# freshness metric is not advanced.
[Unit]
Description=NLW encrypted off-host database backup (one-shot)
Documentation=file:/opt/nlw/docs/runbooks/backup-operations.md
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/nlw/current
# Bounded runtime; a hung backup fails rather than blocking the next window.
TimeoutStartSec=1800
# The backup credentials live in a root-only 0600 env file — never on argv.
# BOTH env files are required: docker-compose.prod.yml interpolates the runtime
# pins/secrets (NLW_IMAGE, POSTGRES_PASSWORD, ... as `${VAR:?}` requireds) for
# EVERY service at render time, so the backup profile cannot render from
# .env.backup alone. The backup credentials (BACKUP_AWS_*, RESTIC_*) are the only
# additions; the `backup` service never receives runtime key mounts.
# /opt/nlw/current is the ACTIVE release (symlink created by the rollout's
# recreate-runtime phase). Install this unit only AFTER the first activation: the
# pre-M12A checkout has no `backup` service and the rollout takes the first
# verified backup itself. The compose project name is explicit.
# --no-deps is REQUIRED: the running postgres container was created from another
# checkout directory (its relative bind mounts differ), and `run` without it
# converges the diverged dependency by RECREATING the live database container.
ExecStart=/usr/bin/docker compose -p app --env-file /opt/nlw/current/.env.prod --env-file /opt/nlw/.env.backup \
    -f /opt/nlw/current/docker-compose.prod.yml --profile backup run --rm --no-deps backup
# Logs flow to the journal (the existing operational logging approach).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nlw-backup

[Install]
WantedBy=multi-user.target
