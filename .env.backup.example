# NLW encrypted off-host backup — environment (PLACEHOLDERS ONLY).
#
# Copy to /opt/nlw/.env.backup on the VPS (mode 0600, NEVER committed) and fill
# with real values from your secret store. See docs/ops/backup-providers.md and
# docs/ops/backup-systemd.md. This file must never be inherited by the api /
# worker / scheduler / web / migrate services (see docker-compose.prod.yml).

APP_ENV=production

# --- Encrypted repository (restic) -----------------------------------------
# S3-compatible repository URL. AWS S3 example (region in the host):
RESTIC_REPOSITORY=s3:https://s3.<region>.amazonaws.com/<your-bucket>/nlw
# Backblaze B2 example:
# RESTIC_REPOSITORY=s3:https://s3.<region>.backblazeb2.com/<your-bucket>/nlw
#
# The repository ENCRYPTION passphrase. LOSING THIS MAKES ALL BACKUPS
# UNRECOVERABLE. Store it SEPARATELY from the object-store keys and off the VPS.
RESTIC_PASSWORD=<repository-encryption-passphrase>

# --- Object-store credentials (dedicated, least-privilege, backup-only) -----
# NOTE: the Compose backup service interpolates the BACKUP_-prefixed names below
# (docker-compose.prod.yml) so that backup credentials can never be confused with
# a runtime/restore credential of the same name.
BACKUP_AWS_ACCESS_KEY_ID=<access-key-id>
BACKUP_AWS_SECRET_ACCESS_KEY=<secret-access-key>
# AWS S3 only (Backblaze encodes region in the URL); safe to leave blank for B2:
BACKUP_AWS_REGION=<region>

# --- Privileged DB connection used ONLY to dump -----------------------------
# Owner/superuser libpq URL (complete dump under FORCE RLS). The password is
# passed via PGPASSWORD to the child, never on argv.
NLW_BACKUP_DATABASE_URL=postgresql://nlw:<owner-password>@postgres:5432/nlw

# --- Source binding written into the backup manifest (M12A-Prep) -------------
# The rollout's `backup` phase passes all three per run. SET the first two here
# so every timer backup is bound to this host/environment as well (the rollout's
# verify-backup gate rejects evidence bound to another instance/environment).
# The release is best left unset for timer runs: a static value goes stale on
# the next rollout, and the gate only binds the release for rollout-taken backups.
# The database system identifier is always recorded from pg_control_system().
NLW_BACKUP_SOURCE_INSTANCE_ID=<ec2-instance-id from deploy/staging/target.env>
NLW_BACKUP_ENVIRONMENT=staging
#NLW_BACKUP_SOURCE_RELEASE=<leave unset for the timer; the rollout sets it per run>

# --- Retention (pilot defaults; documented, not silently assumed) -----------
# Mode: "simple" (job prunes; the writer credential NEEDS s3:DeleteObject) |
# "immutable" (job NEVER prunes; a separate admin `nlw.backup prune` off-VPS does).
# EVERY writer needs s3:DeleteObject on <prefix>/locks/* (restic lock cleanup;
# otherwise the post-upload `restic check` fails and every backup fails).
# "simple" additionally needs delete on the whole prefix; with the documented
# locks-only writer choose "immutable" or the run fails after the (verified)
# upload. Decide explicitly — see backup-providers.md.
NLW_BACKUP_RETENTION_MODE=simple
NLW_BACKUP_RETENTION_DAILY=14
NLW_BACKUP_RETENTION_WEEKLY=8
NLW_BACKUP_RETENTION_MONTHLY=6

# --- Single-execution lock (flock over the whole lifecycle) -----------------
# MUST be on a shared, writable runtime volume so two backup CONTAINERS contend.
# Under Compose the `backup_run` volume mounts at /run/nlw and this is set for you.
NLW_BACKUP_LOCK_FILE=/run/nlw/backup.lock

# --- Freshness / dead-man budget --------------------------------------------
# A verified backup older than this trips the dead-man alert (>24h to tolerate
# the daily timer's randomized delay).
NLW_BACKUP_MAX_AGE_HOURS=26

# --- Host-readable node_exporter textfile the job atomically writes ----------
# NOTE: the `backup` Compose service overrides this to /textfile/nlw_backup.prom
# inside the `backup_textfile` volume (node_exporter reads that volume). This
# value is used only for a bare, non-Compose `python -m nlw.backup backup` run.
NLW_BACKUP_METRICS_FILE=/var/lib/node_exporter/textfile/nlw_backup.prom

# --- Validated temp dir for the transient plaintext dump (wiped, 0700) -------
NLW_BACKUP_WORK_DIR=/tmp/nlw-backup
