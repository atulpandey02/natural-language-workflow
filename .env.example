# Copy to .env and adjust. Never commit .env.
# Read by nlw.core.config.Settings. The docker compose services set their own
# in-container values; this file is for host-run processes and tooling
# (e.g. `uv run alembic ...`, running the API on the host).

APP_ENV=local          # local | dev | staging | production
LOG_LEVEL=info

# Application runtime connects as the restricted nlw_app role (RLS-enforced).
# Points at the docker compose Postgres, published on host port 5433 (5432 is
# left to any native Postgres). In-cluster services use postgres:5432.
DATABASE_URL=postgresql+psycopg://nlw_app:nlw_app@localhost:5433/nlw
# Migrations run as the nlw owner (Alembic only). Falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=postgresql+psycopg://nlw:nlw@localhost:5433/nlw
REDIS_URL=redis://localhost:6379/0

# --- Authentication (Supabase; identity only, see ADR-007) ---
# Production target is asymmetric JWKS verification (RS256/ES256), derived from
# the project URL. JWKS URL and issuer default from SUPABASE_URL if unset.
SUPABASE_URL=
# SUPABASE_JWKS_URL=            # optional override
# SUPABASE_JWT_ISSUER=          # optional override; defaults to {SUPABASE_URL}/auth/v1
SUPABASE_JWT_AUD=authenticated
# LEGACY/dev only — symmetric HS256. Not for production. Leave unset to disable.
# SUPABASE_JWT_SECRET=

# Added in later milestones (do not set yet):
# M6: ANTHROPIC_API_KEY=...   (BYOK; resolved via SecretStore, never logged)

# --- Planner capability policy: demo tools --------------------------------
# fake.* / static.* demo tools stay registered (existing workflow versions keep
# running) but are offered to NEW planning (POST /plans, materialize, GET /tools)
# only when this is explicitly true. Unset = hidden everywhere (fail closed).
# Operator-controlled; a tenant request can never enable them.
DEMO_TOOLS_ENABLED=true
