{
  "_source": "docs/runbooks/dataset-s3-provisioning.md at eb42250 (before the F5 fix); every template except role-operator",
  "templates": {
    "audit-bucket-policy": {
      "Statement": [
        {
          "Action": "s3:GetBucketAcl",
          "Condition": {
            "StringEquals": {
              "aws:SourceAccount": "<ACCOUNT>",
              "aws:SourceArn": "<TRAIL_ARN>"
            }
          },
          "Effect": "Allow",
          "Principal": {
            "Service": "cloudtrail.amazonaws.com"
          },
          "Resource": "arn:aws:s3:::<AUDIT_BUCKET>",
          "Sid": "CloudTrailAclCheck"
        },
        {
          "Action": "s3:PutObject",
          "Condition": {
            "StringEquals": {
              "aws:SourceAccount": "<ACCOUNT>",
              "aws:SourceArn": "<TRAIL_ARN>",
              "s3:x-amz-acl": "bucket-owner-full-control"
            }
          },
          "Effect": "Allow",
          "Principal": {
            "Service": "cloudtrail.amazonaws.com"
          },
          "Resource": "arn:aws:s3:::<AUDIT_BUCKET>/dataset-data-events/AWSLogs/<ACCOUNT>/*",
          "Sid": "CloudTrailWriteThisTrailOnly"
        },
        {
          "Action": "s3:*",
          "Condition": {
            "Bool": {
              "aws:SecureTransport": "false"
            }
          },
          "Effect": "Deny",
          "Principal": "*",
          "Resource": [
            "arn:aws:s3:::<AUDIT_BUCKET>",
            "arn:aws:s3:::<AUDIT_BUCKET>/*"
          ],
          "Sid": "DenyNonTLS"
        },
        {
          "Action": "s3:*",
          "Condition": {
            "ArnLike": {
              "aws:PrincipalArn": [
                "arn:aws:iam::<ACCOUNT>:role/nlw-*-dataset-api",
                "arn:aws:iam::<ACCOUNT>:role/nlw-*-dataset-ingest",
                "arn:aws:iam::<ACCOUNT>:role/nlw-*-dataset-bootstrap",
                "arn:aws:iam::<ACCOUNT>:role/nlw-*-dataset-operator"
              ]
            }
          },
          "Effect": "Deny",
          "Principal": "*",
          "Resource": [
            "arn:aws:s3:::<AUDIT_BUCKET>",
            "arn:aws:s3:::<AUDIT_BUCKET>/*"
          ],
          "Sid": "DenyDatasetRoles"
        },
        {
          "Action": [
            "s3:DeleteObject",
            "s3:DeleteObjectVersion",
            "s3:BypassGovernanceRetention",
            "s3:PutObjectRetention",
            "s3:PutObjectLegalHold"
          ],
          "Condition": {
            "ArnNotEquals": {
              "aws:PrincipalArn": "arn:aws:iam::<ACCOUNT>:role/<AUDIT_ADMIN_ROLE>"
            }
          },
          "Effect": "Deny",
          "Principal": "*",
          "Resource": "arn:aws:s3:::<AUDIT_BUCKET>/*",
          "Sid": "DenyRecordDeletionExceptAuditAdmin"
        },
        {
          "Action": [
            "s3:PutBucket*",
            "s3:DeleteBucket*",
            "s3:PutLifecycleConfiguration",
            "s3:PutEncryptionConfiguration",
            "s3:PutBucketVersioning",
            "s3:PutBucketObjectLockConfiguration"
          ],
          "Condition": {
            "ArnNotEquals": {
              "aws:PrincipalArn": "arn:aws:iam::<ACCOUNT>:role/<AUDIT_ADMIN_ROLE>"
            }
          },
          "Effect": "Deny",
          "Principal": "*",
          "Resource": "arn:aws:s3:::<AUDIT_BUCKET>",
          "Sid": "DenyBucketConfigExceptAuditAdmin"
        }
      ],
      "Version": "2012-10-17"
    },
    "audit-kms-key-statements": [
      {
        "Action": "kms:GenerateDataKey*",
        "Condition": {
          "StringEquals": {
            "aws:SourceAccount": "<ACCOUNT>",
            "aws:SourceArn": "<TRAIL_ARN>"
          },
          "StringLike": {
            "kms:EncryptionContext:aws:cloudtrail:arn": "<TRAIL_ARN>"
          }
        },
        "Effect": "Allow",
        "Principal": {
          "Service": "cloudtrail.amazonaws.com"
        },
        "Resource": "*",
        "Sid": "CloudTrailEncryptThisTrailOnly"
      },
      {
        "Action": "kms:DescribeKey",
        "Condition": {
          "StringEquals": {
            "aws:SourceAccount": "<ACCOUNT>",
            "aws:SourceArn": "<TRAIL_ARN>"
          }
        },
        "Effect": "Allow",
        "Principal": {
          "Service": "cloudtrail.amazonaws.com"
        },
        "Resource": "*",
        "Sid": "CloudTrailDescribeKey"
      },
      {
        "Action": "kms:Decrypt",
        "Condition": {
          "StringEquals": {
            "kms:EncryptionContext:aws:cloudtrail:arn": "<TRAIL_ARN>"
          }
        },
        "Effect": "Allow",
        "Principal": {
          "AWS": "arn:aws:iam::<ACCOUNT>:role/<AUDIT_READER_ROLE>"
        },
        "Resource": "*",
        "Sid": "AuditReadersDecrypt"
      }
    ],
    "dataset-bucket-lifecycle": {
      "Rules": [
        {
          "AbortIncompleteMultipartUpload": {
            "DaysAfterInitiation": 1
          },
          "Filter": {
            "Prefix": "versions/"
          },
          "ID": "abort-incomplete-multipart",
          "Status": "Enabled"
        }
      ]
    },
    "dataset-bucket-policy": {
      "Statement": [
        {
          "Action": "s3:*",
          "Condition": {
            "Bool": {
              "aws:SecureTransport": "false"
            }
          },
          "Effect": "Deny",
          "Principal": "*",
          "Resource": [
            "arn:aws:s3:::<BUCKET>",
            "arn:aws:s3:::<BUCKET>/*"
          ],
          "Sid": "DenyNonTLS"
        },
        {
          "Action": "s3:*",
          "Condition": {
            "StringNotEquals": {
              "aws:PrincipalAccount": "<ACCOUNT>"
            }
          },
          "Effect": "Deny",
          "Principal": "*",
          "Resource": [
            "arn:aws:s3:::<BUCKET>",
            "arn:aws:s3:::<BUCKET>/*"
          ],
          "Sid": "DenyOutsideAccount"
        },
        {
          "Action": "s3:*",
          "Condition": {
            "ArnLike": {
              "aws:PrincipalArn": "arn:aws:iam::<ACCOUNT>:role/nlw-<OTHER_ENV>-*"
            }
          },
          "Effect": "Deny",
          "Principal": "*",
          "Resource": [
            "arn:aws:s3:::<BUCKET>",
            "arn:aws:s3:::<BUCKET>/*"
          ],
          "Sid": "DenyOtherEnvironmentRoles"
        },
        {
          "Action": "s3:PutObject",
          "Condition": {
            "Bool": {
              "s3:ObjectCreationOperation": "true"
            },
            "Null": {
              "s3:if-none-match": "true"
            }
          },
          "Effect": "Deny",
          "Principal": "*",
          "Resource": "arn:aws:s3:::<BUCKET>/versions/*",
          "Sid": "DenyUnconditionalCreate"
        },
        {
          "Action": "s3:PutObject",
          "Condition": {
            "Null": {
              "s3:x-amz-server-side-encryption": "true"
            }
          },
          "Effect": "Deny",
          "Principal": "*",
          "Resource": "arn:aws:s3:::<BUCKET>/*",
          "Sid": "DenyMissingSseAlgorithmHeader"
        },
        {
          "Action": "s3:PutObject",
          "Condition": {
            "Null": {
              "s3:x-amz-server-side-encryption-aws-kms-key-id": "true"
            }
          },
          "Effect": "Deny",
          "Principal": "*",
          "Resource": "arn:aws:s3:::<BUCKET>/*",
          "Sid": "DenyMissingSseKmsKeyHeader"
        },
        {
          "Action": "s3:PutObject",
          "Condition": {
            "StringNotEquals": {
              "s3:x-amz-server-side-encryption": "aws:kms"
            }
          },
          "Effect": "Deny",
          "Principal": "*",
          "Resource": "arn:aws:s3:::<BUCKET>/*",
          "Sid": "DenyWrongSseAlgorithm"
        },
        {
          "Action": "s3:PutObject",
          "Condition": {
            "StringNotEquals": {
              "s3:x-amz-server-side-encryption-aws-kms-key-id": "<KEY_ARN>"
            }
          },
          "Effect": "Deny",
          "Principal": "*",
          "Resource": "arn:aws:s3:::<BUCKET>/*",
          "Sid": "DenyWrongSseKmsKey"
        },
        {
          "Action": [
            "s3:DeleteObject",
            "s3:DeleteObjectVersion"
          ],
          "Condition": {
            "ArnNotEquals": {
              "aws:PrincipalArn": [
                "arn:aws:iam::<ACCOUNT>:role/nlw-<ENV>-dataset-operator"
              ]
            }
          },
          "Effect": "Deny",
          "Principal": "*",
          "Resource": "arn:aws:s3:::<BUCKET>/*",
          "Sid": "DenyDeleteExceptOperator"
        },
        {
          "Action": [
            "s3:PutBucket*",
            "s3:DeleteBucket*",
            "s3:PutLifecycleConfiguration",
            "s3:PutEncryptionConfiguration",
            "s3:PutBucketVersioning"
          ],
          "Condition": {
            "ArnNotEquals": {
              "aws:PrincipalArn": [
                "arn:aws:iam::<ACCOUNT>:role/<ADMIN_ROLE>"
              ]
            }
          },
          "Effect": "Deny",
          "Principal": "*",
          "Resource": "arn:aws:s3:::<BUCKET>",
          "Sid": "DenyBucketConfigExceptAdmin"
        }
      ],
      "Version": "2012-10-17"
    },
    "dataset-kms-key-statement": {
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Condition": {
        "StringEquals": {
          "kms:EncryptionContext:aws:s3:arn": "arn:aws:s3:::<BUCKET>",
          "kms:ViaService": "s3.us-east-1.amazonaws.com"
        }
      },
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::<ACCOUNT>:role/nlw-<ENV>-dataset-api",
          "arn:aws:iam::<ACCOUNT>:role/nlw-<ENV>-dataset-ingest",
          "arn:aws:iam::<ACCOUNT>:role/nlw-<ENV>-dataset-operator"
        ]
      },
      "Resource": "*",
      "Sid": "UseViaS3ForThisBucketOnly"
    },
    "role-api": {
      "Statement": [
        {
          "Action": [
            "s3:PutObject",
            "s3:AbortMultipartUpload"
          ],
          "Effect": "Allow",
          "Resource": "arn:aws:s3:::<BUCKET>/versions/*",
          "Sid": "CreateOnce"
        },
        {
          "Action": [
            "s3:GetObject",
            "s3:GetObjectAttributes"
          ],
          "Effect": "Allow",
          "Resource": "arn:aws:s3:::<BUCKET>/versions/*",
          "Sid": "RetryAndOrphanMetadata"
        },
        {
          "Action": [
            "kms:GenerateDataKey",
            "kms:Decrypt"
          ],
          "Effect": "Allow",
          "Resource": "<KEY_ARN>",
          "Sid": "Encrypt"
        },
        {
          "Action": [
            "s3:*",
            "kms:*"
          ],
          "Condition": {
            "StringNotEquals": {
              "aws:ResourceTag/nlw-env": "<ENV>"
            }
          },
          "Effect": "Deny",
          "Resource": [
            "arn:aws:s3:::nlw-<OTHER_ENV>-datasets-*",
            "arn:aws:s3:::nlw-<OTHER_ENV>-datasets-*/*",
            "arn:aws:kms:us-east-1:<ACCOUNT>:key/*"
          ],
          "Sid": "NeverOtherEnvironment"
        },
        {
          "Action": [
            "cloudtrail:*",
            "s3:*",
            "kms:*"
          ],
          "Effect": "Deny",
          "Resource": [
            "<TRAIL_ARN>",
            "arn:aws:s3:::<AUDIT_BUCKET>",
            "arn:aws:s3:::<AUDIT_BUCKET>/*",
            "<AUDIT_KEY_ARN>"
          ],
          "Sid": "NeverTouchAudit"
        },
        {
          "Action": [
            "cloudtrail:StopLogging",
            "cloudtrail:DeleteTrail",
            "cloudtrail:UpdateTrail",
            "cloudtrail:PutEventSelectors",
            "cloudtrail:PutInsightSelectors"
          ],
          "Effect": "Deny",
          "Resource": "*",
          "Sid": "NeverAlterAnyTrail"
        }
      ],
      "Version": "2012-10-17"
    },
    "role-bootstrap": {
      "Statement": [
        {
          "Action": "sts:AssumeRole",
          "Effect": "Allow",
          "Resource": [
            "arn:aws:iam::<ACCOUNT>:role/nlw-<ENV>-dataset-api",
            "arn:aws:iam::<ACCOUNT>:role/nlw-<ENV>-dataset-ingest"
          ],
          "Sid": "AssumeRuntimeRolesOnly"
        },
        {
          "Action": [
            "cloudtrail:*",
            "s3:*",
            "kms:*"
          ],
          "Effect": "Deny",
          "Resource": [
            "<TRAIL_ARN>",
            "arn:aws:s3:::<AUDIT_BUCKET>",
            "arn:aws:s3:::<AUDIT_BUCKET>/*",
            "<AUDIT_KEY_ARN>"
          ],
          "Sid": "NeverTouchAudit"
        },
        {
          "Action": [
            "cloudtrail:StopLogging",
            "cloudtrail:DeleteTrail",
            "cloudtrail:UpdateTrail",
            "cloudtrail:PutEventSelectors",
            "cloudtrail:PutInsightSelectors"
          ],
          "Effect": "Deny",
          "Resource": "*",
          "Sid": "NeverAlterAnyTrail"
        }
      ],
      "Version": "2012-10-17"
    },
    "role-ingest": {
      "Statement": [
        {
          "Action": [
            "s3:GetObject"
          ],
          "Effect": "Allow",
          "Resource": "arn:aws:s3:::<BUCKET>/versions/*",
          "Sid": "ReadVersions"
        },
        {
          "Action": [
            "kms:Decrypt"
          ],
          "Effect": "Allow",
          "Resource": "<KEY_ARN>",
          "Sid": "Decrypt"
        },
        {
          "Action": [
            "s3:*",
            "kms:*"
          ],
          "Effect": "Deny",
          "Resource": [
            "arn:aws:s3:::nlw-<OTHER_ENV>-datasets-*",
            "arn:aws:s3:::nlw-<OTHER_ENV>-datasets-*/*"
          ],
          "Sid": "NeverOtherEnvironment"
        },
        {
          "Action": [
            "cloudtrail:*",
            "s3:*",
            "kms:*"
          ],
          "Effect": "Deny",
          "Resource": [
            "<TRAIL_ARN>",
            "arn:aws:s3:::<AUDIT_BUCKET>",
            "arn:aws:s3:::<AUDIT_BUCKET>/*",
            "<AUDIT_KEY_ARN>"
          ],
          "Sid": "NeverTouchAudit"
        },
        {
          "Action": [
            "cloudtrail:StopLogging",
            "cloudtrail:DeleteTrail",
            "cloudtrail:UpdateTrail",
            "cloudtrail:PutEventSelectors",
            "cloudtrail:PutInsightSelectors"
          ],
          "Effect": "Deny",
          "Resource": "*",
          "Sid": "NeverAlterAnyTrail"
        }
      ],
      "Version": "2012-10-17"
    },
    "trail-advanced-event-selectors": [
      {
        "FieldSelectors": [
          {
            "Equals": [
              "Data"
            ],
            "Field": "eventCategory"
          },
          {
            "Equals": [
              "AWS::S3::Object"
            ],
            "Field": "resources.type"
          },
          {
            "Field": "resources.ARN",
            "StartsWith": [
              "arn:aws:s3:::<BUCKET>/"
            ]
          }
        ],
        "Name": "nlw-<ENV>-dataset-object-reads-and-writes"
      }
    ]
  }
}
