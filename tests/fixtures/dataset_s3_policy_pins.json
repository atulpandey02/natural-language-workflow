     ]
    },
    "NeverOtherEnvironmentKeys": {
     "Effect": "Deny",
     "Action": "kms:*",
     "Resource": "*",
     "Condition": {
      "StringEquals": {
       "aws:ResourceTag/nlw-env": "<OTHER_ENV>"
      }
     }
    },
    "NeverEscalate": {
     "Effect": "Deny",
     "Action": [
      "iam:AttachGroupPolicy",
      "iam:AttachRolePolicy",
      "iam:AttachUserPolicy",
      "iam:CreateAccessKey",
      "iam:CreateLoginProfile",
      "iam:CreatePolicy",
      "iam:CreatePolicyVersion",
      "iam:CreateUser",
      "iam:DeletePolicy",
      "iam:DeletePolicyVersion",
      "iam:DeleteRolePermissionsBoundary",
