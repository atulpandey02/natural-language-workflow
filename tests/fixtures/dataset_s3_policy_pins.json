      "iam:PutRolePermissionsBoundary",
      "iam:PutUserPermissionsBoundary",
      "iam:PutUserPolicy",
      "iam:SetDefaultPolicyVersion",
      "iam:UpdateLoginProfile",
      "identitystore:*",
      "sso-directory:*",
      "sso:*"
     ],
     "Resource": "*"
    },
    "NeverIdentityProviders": {
     "Effect": "Deny",
     "Action": [
      "iam:*OpenIDConnectProvider*",
      "iam:*SAMLProvider"
     ],
     "Resource": "*"
    },
    "NeverOrganizationOrAccountChanges": {
     "Effect": "Deny",
     "Action": [
      "account:*",
      "organizations:Accept*",
      "organizations:Attach*",
      "organizations:Cancel*",
      "organizations:Close*",
      "organizations:Create*",
      "organizations:Decline*",
      "organizations:Delete*",
      "organizations:Deregister*",
      "organizations:Detach*",
      "organizations:Disable*",
      "organizations:Enable*",
      "organizations:Invite*",
      "organizations:Leave*",
      "organizations:Move*",
      "organizations:Put*",
      "organizations:Register*",
      "organizations:Remove*",
      "organizations:Tag*",
      "organizations:Untag*",
      "organizations:Update*"
     ],
     "Resource": "*"
    },
    "NeverDirectKmsGrants": {
     "Effect": "Deny",
     "Action": [
      "kms:CreateGrant",
      "kms:RetireGrant",
      "kms:RevokeGrant"
     ],
     "Resource": "*",
     "Condition": {
      "Null": {
       "kms:ViaService": "true"
      }
     }
    },
    "AssumeOnlyTheProofRoles": {
     "Effect": "Deny",
     "Action": [
      "sts:AssumeRole",
      "sts:AssumeRoleWithSAML",
      "sts:AssumeRoleWithWebIdentity",
      "sts:GetFederationToken"
     ],
     "NotResource": [
      "arn:aws:iam::<ACCOUNT>:role/nlw-<ENV>-dataset-api",
      "arn:aws:iam::<ACCOUNT>:role/nlw-<ENV>-dataset-ingest",
      "arn:aws:iam::<ACCOUNT>:role/nlw-<ENV>-dataset-operator",
