 "trust-bootstrap": {
  "sids": [
   "Ec2InstanceProfileOnly"
  ],
  "denies": {}
 },
 "trust-api": {
  "sids": [
   "BootstrapWithApiSessionName"
  ],
  "denies": {}
 },
 "trust-ingest": {
  "sids": [
   "BootstrapWithIngestSessionName"
  ],
  "denies": {}
 },
 "trust-human-mfa": {
  "sids": [
   "NamedHumansWithMfa",
   "DenyWithoutMfaContext",
   "DenyWithoutMfa",
   "DenyMachineRoles"
  ],
  "denies": {
   "DenyWithoutMfaContext": {
    "Effect": "Deny",
    "Principal": {
     "AWS": "*"
    },
    "Action": "sts:AssumeRole",
    "Condition": {
     "Null": {
      "aws:MultiFactorAuthPresent": "true"
     }
    }
   },
   "DenyWithoutMfa": {
    "Effect": "Deny",
    "Principal": {
     "AWS": "*"
    },
    "Action": "sts:AssumeRole",
    "Condition": {
     "Bool": {
      "aws:MultiFactorAuthPresent": "false"
     }
    }
   },
   "DenyMachineRoles": {
    "Effect": "Deny",
    "Principal": {
     "AWS": "*"
    },
    "Action": "sts:AssumeRole",
    "Condition": {
     "ArnLike": {
      "aws:PrincipalArn": [
       "arn:aws:iam::<ACCOUNT>:role/nlw-*-dataset-bootstrap",
       "arn:aws:iam::<ACCOUNT>:role/nlw-*-dataset-api",
       "arn:aws:iam::<ACCOUNT>:role/nlw-*-dataset-ingest"
      ]
     }
    }
   }
  }
 },
 "audit-kms-key-statements": {
  "sids": [
   "AdministerNeverUse",
   "CloudTrailEncryptThisTrailOnly",
   "CloudTrailDescribeKey",
   "AuditReadersDecrypt"
  ],
  "denies": {}
 },
 "audit-bucket-policy": {
  "sids": [
   "CloudTrailAclCheck",
   "CloudTrailWriteThisTrailOnly",
   "DenyNonTLS",
   "DenyDatasetRoles",
   "DenyRecordDeletionExceptAuditAdmin",
   "DenyBucketConfigExceptAuditAdmin"
  ],
  "denies": {
   "DenyNonTLS": {
    "Effect": "Deny",
    "Principal": "*",
    "Action": "s3:*",
    "Resource": [
     "arn:aws:s3:::<AUDIT_BUCKET>",
     "arn:aws:s3:::<AUDIT_BUCKET>/*"
    ],
    "Condition": {
     "Bool": {
      "aws:SecureTransport": "false"
     }
    }
   },
   "DenyDatasetRoles": {
    "Effect": "Deny",
    "Principal": "*",
    "Action": "s3:*",
    "Resource": [
     "arn:aws:s3:::<AUDIT_BUCKET>",
     "arn:aws:s3:::<AUDIT_BUCKET>/*"
    ],
    "Condition": {
     "ArnLike": {
      "aws:PrincipalArn": [
       "arn:aws:iam::<ACCOUNT>:role/nlw-*-dataset-api",
       "arn:aws:iam::<ACCOUNT>:role/nlw-*-dataset-ingest",
       "arn:aws:iam::<ACCOUNT>:role/nlw-*-dataset-bootstrap",
       "arn:aws:iam::<ACCOUNT>:role/nlw-*-dataset-operator"
      ]
     }
    }
   },
   "DenyRecordDeletionExceptAuditAdmin": {
    "Effect": "Deny",
    "Principal": "*",
    "Action": [
     "s3:DeleteObject",
     "s3:DeleteObjectVersion",
     "s3:BypassGovernanceRetention",
     "s3:PutObjectRetention",
     "s3:PutObjectLegalHold"
    ],
    "Resource": "arn:aws:s3:::<AUDIT_BUCKET>/*",
    "Condition": {
     "ArnNotEquals": {
      "aws:PrincipalArn": "arn:aws:iam::<ACCOUNT>:role/<AUDIT_ADMIN_ROLE>"
     }
    }
   },
   "DenyBucketConfigExceptAuditAdmin": {
    "Effect": "Deny",
    "Principal": "*",
    "Action": [
     "s3:PutBucket*",
     "s3:DeleteBucket*",
     "s3:PutLifecycleConfiguration",
     "s3:PutEncryptionConfiguration",
     "s3:PutBucketVersioning",
     "s3:PutBucketObjectLockConfiguration",
     "s3:PutReplicationConfiguration",
     "s3:PutInventoryConfiguration",
     "s3:PutAnalyticsConfiguration",
     "s3:PutMetricsConfiguration",
     "s3:PutIntelligentTieringConfiguration",
     "s3:PutAccelerateConfiguration"
    ],
    "Resource": "arn:aws:s3:::<AUDIT_BUCKET>",
    "Condition": {
     "ArnNotEquals": {
      "aws:PrincipalArn": "arn:aws:iam::<ACCOUNT>:role/<AUDIT_ADMIN_ROLE>"
     }
    }
   }
  }
 }
}