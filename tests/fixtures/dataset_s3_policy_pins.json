    "PassOnlyTheBootstrapRole": {
     "Effect": "Deny",
     "Action": "iam:PassRole",
     "NotResource": "arn:aws:iam::<ACCOUNT>:role/nlw-<ENV>-dataset-bootstrap"
    },
    "PassTheBootstrapRoleOnlyToEc2": {
     "Effect": "Deny",
     "Action": "iam:PassRole",
     "Resource": "*",
     "Condition": {
      "Null": {
       "iam:PassedToService": "false"
      },
      "StringNotEquals": {
       "iam:PassedToService": "ec2.amazonaws.com"
      }
     }
    },
    "NeverIndirectExecution": {
     "Effect": "Deny",
     "Action": [
      "cloudformation:*",
      "codebuild:*",
