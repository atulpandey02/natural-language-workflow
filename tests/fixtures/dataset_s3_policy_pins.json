   ],
   "denies": {
    "PassTheBootstrapRoleOnlyToEc2": {
     "Effect": "Deny",
     "Action": "iam:PassRole",
     "Resource": "*",
     "Condition": {
      "Null": {
       "iam:PassedToService": "false"
      },
      "StringNotEquals": {
       "iam:PassedToService": "ec2.amazonaws.com"
      }
     }
    },
    "NeverUseTheProofRoles": {
     "Effect": "Deny",
     "Action": "sts:AssumeRole",
     "Resource": [
      "arn:aws:iam::<ACCOUNT>:role/nlw-<ENV>-dataset-bootstrap",
