{
 "dataset-kms-key-statements": {
  "sids": [
   "AdministerNeverUse",
   "ApiEncryptViaS3ForThisBucketOnly",
   "ReadersDecryptViaS3ForThisBucketOnly"
  ],
  "denies": {}
 },
 "dataset-bucket-policy": {
  "sids": [
   "DenyNonTLS",
   "DenyOutsideAccount",
   "DenyOtherEnvironmentRoles",
   "DenyUnconditionalCreate",
   "DenyMissingSseAlgorithmHeader",
   "DenyMissingSseKmsKeyHeader",
   "DenyWrongSseAlgorithm",
   "DenyWrongSseKmsKey",
   "DenyServerSideCopy",
   "DenyDeleteExceptOperator",
   "DenyBucketConfigExceptAdmin"
  ],
  "denies": {
   "DenyNonTLS": {
    "Effect": "Deny",
    "Principal": "*",
    "Action": "s3:*",
    "Resource": [
     "arn:aws:s3:::<BUCKET>",
     "arn:aws:s3:::<BUCKET>/*"
    ],
    "Condition": {
     "Bool": {
      "aws:SecureTransport": "false"
     }
    }
   },
   "DenyOutsideAccount": {
    "Effect": "Deny",
    "Principal": "*",
    "Action": "s3:*",
    "Resource": [
     "arn:aws:s3:::<BUCKET>",
     "arn:aws:s3:::<BUCKET>/*"
    ],
    "Condition": {
     "StringNotEquals": {
      "aws:PrincipalAccount": "<ACCOUNT>"
     }
    }
   },
   "DenyOtherEnvironmentRoles": {
    "Effect": "Deny",
    "Principal": "*",
    "Action": "s3:*",
    "Resource": [
     "arn:aws:s3:::<BUCKET>",
     "arn:aws:s3:::<BUCKET>/*"
    ],
    "Condition": {
     "ArnLike": {
      "aws:PrincipalArn": "arn:aws:iam::<ACCOUNT>:role/nlw-<OTHER_ENV>-*"
     }
    }
   },
   "DenyUnconditionalCreate": {
    "Effect": "Deny",
    "Principal": "*",
    "Action": "s3:PutObject",
    "Resource": "arn:aws:s3:::<BUCKET>/versions/*",
    "Condition": {
     "Null": {
      "s3:if-none-match": "true"
     },
     "Bool": {
      "s3:ObjectCreationOperation": "true"
     }
    }
   },
   "DenyMissingSseAlgorithmHeader": {
    "Effect": "Deny",
    "Principal": "*",
    "Action": "s3:PutObject",
    "Resource": "arn:aws:s3:::<BUCKET>/*",
    "Condition": {
     "Null": {
      "s3:x-amz-server-side-encryption": "true"
     }
    }
   },
   "DenyMissingSseKmsKeyHeader": {
    "Effect": "Deny",
    "Principal": "*",
    "Action": "s3:PutObject",
    "Resource": "arn:aws:s3:::<BUCKET>/*",
    "Condition": {
     "Null": {
      "s3:x-amz-server-side-encryption-aws-kms-key-id": "true"
     }
    }
   },
   "DenyWrongSseAlgorithm": {
    "Effect": "Deny",
    "Principal": "*",
    "Action": "s3:PutObject",
    "Resource": "arn:aws:s3:::<BUCKET>/*",
    "Condition": {
     "StringNotEquals": {
      "s3:x-amz-server-side-encryption": "aws:kms"
     }
    }
   },
   "DenyWrongSseKmsKey": {
    "Effect": "Deny",
    "Principal": "*",
    "Action": "s3:PutObject",
    "Resource": "arn:aws:s3:::<BUCKET>/*",
    "Condition": {
     "StringNotEquals": {
      "s3:x-amz-server-side-encryption-aws-kms-key-id": "<KEY_ARN>"
     }
    }
   },
   "DenyServerSideCopy": {
    "Effect": "Deny",
    "Principal": "*",
    "Action": "s3:PutObject",
    "Resource": "arn:aws:s3:::<BUCKET>/*",
    "Condition": {
     "Null": {
      "s3:x-amz-copy-source": "false"
     }
    }
   },
   "DenyDeleteExceptOperator": {
    "Effect": "Deny",
    "Principal": "*",
    "Action": [
     "s3:DeleteObject",
     "s3:DeleteObjectVersion"
    ],
    "Resource": "arn:aws:s3:::<BUCKET>/*",
    "Condition": {
     "ArnNotEquals": {
      "aws:PrincipalArn": [
       "arn:aws:iam::<ACCOUNT>:role/nlw-<ENV>-dataset-operator"
      ]
     }
    }
   },
   "DenyBucketConfigExceptAdmin": {
    "Effect": "Deny",
    "Principal": "*",
    "Action": [
     "s3:PutBucket*",
     "s3:DeleteBucket*",
     "s3:PutLifecycleConfiguration",
     "s3:PutEncryptionConfiguration",
     "s3:PutBucketVersioning",
     "s3:PutReplicationConfiguration",
     "s3:PutInventoryConfiguration",
     "s3:PutAnalyticsConfiguration",
     "s3:PutMetricsConfiguration",
     "s3:PutIntelligentTieringConfiguration",
     "s3:PutAccelerateConfiguration"
    ],
    "Resource": "arn:aws:s3:::<BUCKET>",
    "Condition": {
     "ArnNotEquals": {
      "aws:PrincipalArn": [
       "arn:aws:iam::<ACCOUNT>:role/<ADMIN_ROLE>"
      ]
     }
    }
   }
  }
 },
 "role-bootstrap": {
  "sids": [
   "AssumeRuntimeRolesOnly",
   "NeverAssumeAnyOtherRole",
   "NeverDataPlane",
   "NeverPassOrAttachDatasetRoles",
   "NeverTouchAudit",
   "NeverAlterAnyTrail"
  ],
  "denies": {
   "NeverAssumeAnyOtherRole": {
    "Effect": "Deny",
    "Action": "sts:AssumeRole",
    "NotResource": [
     "arn:aws:iam::<ACCOUNT>:role/nlw-<ENV>-dataset-api",
     "arn:aws:iam::<ACCOUNT>:role/nlw-<ENV>-dataset-ingest"
    ]
   },
   "NeverDataPlane": {
    "Effect": "Deny",
    "Action": [
     "s3:*",
     "kms:*"
    ],
    "Resource": "*"
   },
   "NeverPassOrAttachDatasetRoles": {
    "Effect": "Deny",
    "Action": [
     "iam:PassRole",
     "ec2:AssociateIamInstanceProfile",
     "ec2:ReplaceIamInstanceProfileAssociation"
    ],
    "Resource": "*"
   },
   "NeverTouchAudit": {
    "Effect": "Deny",
    "Action": [
     "cloudtrail:*",
     "s3:*",
     "kms:*"
    ],
    "Resource": [
     "<TRAIL_ARN>",
     "arn:aws:s3:::<AUDIT_BUCKET>",
     "arn:aws:s3:::<AUDIT_BUCKET>/*",
     "<AUDIT_KEY_ARN>"
    ]
   },
   "NeverAlterAnyTrail": {
    "Effect": "Deny",
    "Action": [
     "cloudtrail:StopLogging",
     "cloudtrail:DeleteTrail",
     "cloudtrail:UpdateTrail",
     "cloudtrail:PutEventSelectors",
     "cloudtrail:PutInsightSelectors"
    ],
    "Resource": "*"
   }
  }
 },
