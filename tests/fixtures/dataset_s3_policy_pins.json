  },
  "boundary-bootstrap": {
   "sids": [
    "AssumeRuntimeRolesOnly"
   ],
   "denies": {}
  },
  "boundary-ingest": {
   "sids": [
    "ReadVersions",
    "Decrypt"
   ],
   "denies": {}
  },
  "boundary-operator": {
   "sids": [
    "ListVersionsBounded",
    "ListInProgressUploads",
    "PurgeAndVerify",
    "Decrypt"
   ],
   "denies": {}
  },
  "dataset-bucket-policy": {
   "sids": [
    "DenyNonTLS",
    "DenyOutsideAccount",
    "DenyOtherEnvironmentRoles",
    "DenyUnconditionalCreate",
    "DenyMissingSseAlgorithmHeader",
    "DenyMissingSseKmsKeyHeader",
    "DenyWrongSseAlgorithm",
    "DenyWrongSseKmsKey",
    "DenyServerSideCopy",
    "DenyDeleteExceptOperator",
    "DenyBucketConfigExceptAdmin"
   ],
   "denies": {
    "DenyNonTLS": {
     "Effect": "Deny",
     "Principal": "*",
     "Action": "s3:*",
     "Resource": [
      "arn:aws:s3:::<BUCKET>",
      "arn:aws:s3:::<BUCKET>/*"
     ],
     "Condition": {
      "Bool": {
       "aws:SecureTransport": "false"
      }
     }
    },
    "DenyOutsideAccount": {
     "Effect": "Deny",
     "Principal": "*",
     "Action": "s3:*",
     "Resource": [
      "arn:aws:s3:::<BUCKET>",
      "arn:aws:s3:::<BUCKET>/*"
     ],
     "Condition": {
      "StringNotEquals": {
       "aws:PrincipalAccount": "<ACCOUNT>"
      }
     }
    },
    "DenyOtherEnvironmentRoles": {
     "Effect": "Deny",
     "Principal": "*",
     "Action": "s3:*",
     "Resource": [
      "arn:aws:s3:::<BUCKET>",
      "arn:aws:s3:::<BUCKET>/*"
     ],
     "Condition": {
      "ArnLike": {
       "aws:PrincipalArn": "arn:aws:iam::<ACCOUNT>:role/nlw-<OTHER_ENV>-*"
      }
     }
    },
    "DenyUnconditionalCreate": {
     "Effect": "Deny",
     "Principal": "*",
     "Action": "s3:PutObject",
     "Resource": "arn:aws:s3:::<BUCKET>/versions/*",
     "Condition": {
      "Null": {
       "s3:if-none-match": "true"
      },
      "Bool": {
       "s3:ObjectCreationOperation": "true"
      }
     }
    },
    "DenyMissingSseAlgorithmHeader": {
     "Effect": "Deny",
     "Principal": "*",
     "Action": "s3:PutObject",
     "Resource": "arn:aws:s3:::<BUCKET>/*",
     "Condition": {
      "Null": {
       "s3:x-amz-server-side-encryption": "true"
      }
     }
    },
    "DenyMissingSseKmsKeyHeader": {
     "Effect": "Deny",
     "Principal": "*",
     "Action": "s3:PutObject",
     "Resource": "arn:aws:s3:::<BUCKET>/*",
     "Condition": {
      "Null": {
       "s3:x-amz-server-side-encryption-aws-kms-key-id": "true"
      }
     }
    },
    "DenyWrongSseAlgorithm": {
     "Effect": "Deny",
     "Principal": "*",
     "Action": "s3:PutObject",
     "Resource": "arn:aws:s3:::<BUCKET>/*",
     "Condition": {
      "StringNotEquals": {
       "s3:x-amz-server-side-encryption": "aws:kms"
      }
     }
    },
    "DenyWrongSseKmsKey": {
     "Effect": "Deny",
     "Principal": "*",
     "Action": "s3:PutObject",
     "Resource": "arn:aws:s3:::<BUCKET>/*",
     "Condition": {
      "StringNotEquals": {
       "s3:x-amz-server-side-encryption-aws-kms-key-id": "<KEY_ARN>"
      }
     }
    },
    "DenyServerSideCopy": {
     "Effect": "Deny",
     "Principal": "*",
     "Action": "s3:PutObject",
     "Resource": "arn:aws:s3:::<BUCKET>/*",
     "Condition": {
      "Null": {
       "s3:x-amz-copy-source": "false"
      }
     }
    },
    "DenyDeleteExceptOperator": {
     "Effect": "Deny",
     "Principal": "*",
     "Action": [
      "s3:DeleteObject",
      "s3:DeleteObjectVersion"
     ],
     "Resource": "arn:aws:s3:::<BUCKET>/*",
     "Condition": {
      "ArnNotEquals": {
       "aws:PrincipalArn": [
        "arn:aws:iam::<ACCOUNT>:role/nlw-<ENV>-dataset-operator"
       ]
      }
     }
    },
    "DenyBucketConfigExceptAdmin": {
     "Effect": "Deny",
     "Principal": "*",
     "Action": [
      "s3:PutBucket*",
      "s3:DeleteBucket*",
      "s3:PutLifecycleConfiguration",
      "s3:PutEncryptionConfiguration",
      "s3:PutBucketVersioning",
      "s3:PutReplicationConfiguration",
      "s3:PutInventoryConfiguration",
      "s3:PutAnalyticsConfiguration",
      "s3:PutMetricsConfiguration",
      "s3:PutIntelligentTieringConfiguration",
      "s3:PutAccelerateConfiguration"
     ],
     "Resource": "arn:aws:s3:::<BUCKET>",
     "Condition": {
      "ArnNotEquals": {
       "aws:PrincipalArn": [
        "arn:aws:iam::<ACCOUNT>:role/<ADMIN_ROLE>"
       ]
      }
     }
    }
   }
  },
  "dataset-kms-key-statements": {
   "sids": [
    "AdministerNeverUse",
    "ApiEncryptViaS3ForThisBucketOnly",
    "ReadersDecryptViaS3ForThisBucketOnly"
   ],
   "denies": {}
  },
