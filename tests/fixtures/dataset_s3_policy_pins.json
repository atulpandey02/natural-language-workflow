  "trust-api": {
   "sids": [
    "BootstrapWithApiSessionName"
   ],
   "denies": {}
  },
  "trust-bootstrap": {
   "sids": [
    "Ec2InstanceProfileOnly"
   ],
   "denies": {}
  },
  "trust-human": {
   "sids": [
    "NamedSsoPermissionSetRolesOnly",
    "DenyAnythingButIdentityCenter",
    "DenyMachineRoles"
   ],
   "denies": {
    "DenyAnythingButIdentityCenter": {
     "Effect": "Deny",
     "Principal": {
      "AWS": "*"
     },
     "Action": "sts:AssumeRole",
     "Condition": {
      "ArnNotLike": {
       "aws:PrincipalArn": "arn:aws:iam::<ACCOUNT>:role/aws-reserved/sso.amazonaws.com/*"
      }
     }
    },
    "DenyMachineRoles": {
     "Effect": "Deny",
     "Principal": {
      "AWS": "*"
     },
     "Action": "sts:AssumeRole",
     "Condition": {
      "ArnLike": {
       "aws:PrincipalArn": [
        "arn:aws:iam::<ACCOUNT>:role/nlw-*-dataset-bootstrap",
        "arn:aws:iam::<ACCOUNT>:role/nlw-*-dataset-api",
        "arn:aws:iam::<ACCOUNT>:role/nlw-*-dataset-ingest"
       ]
      }
     }
    }
   }
  },
  "trust-ingest": {
   "sids": [
    "BootstrapWithIngestSessionName"
   ],
   "denies": {}
  }
 },
 "documents": {
  "audit-bucket-lifecycle": {
   "Rules": [
    {
     "ID": "expire-after-retention",
     "Status": "Enabled",
     "Filter": {
      "Prefix": "dataset-data-events/"
     },
     "Expiration": {
      "Days": "<AUDIT_EXPIRY_DAYS>"
     },
     "NoncurrentVersionExpiration": {
      "NoncurrentDays": 1
     }
    }
   ]
  },
  "dataset-bucket-lifecycle": {
   "Rules": [
    {
     "ID": "abort-incomplete-multipart",
     "Status": "Enabled",
     "Filter": {
      "Prefix": "versions/"
     },
     "AbortIncompleteMultipartUpload": {
      "DaysAfterInitiation": 1
     }
    }
   ]
  },
  "trail-advanced-event-selectors": [
   {
    "Name": "nlw-<ENV>-dataset-object-reads-and-writes",
    "FieldSelectors": [
     {
      "Field": "eventCategory",
      "Equals": [
       "Data"
      ]
     },
     {
      "Field": "resources.type",
      "Equals": [
       "AWS::S3::Object"
      ]
     },
     {
      "Field": "resources.ARN",
      "StartsWith": [
       "arn:aws:s3:::<BUCKET>/"
      ]
     }
    ]
   }
  ]
 }
}
