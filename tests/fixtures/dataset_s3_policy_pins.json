  "proof-principal-denies": {
   "sids": [
    "NeverOtherEnvironmentNames",
    "NeverOtherEnvironmentKeys",
    "NeverEscalate",
    "NeverIdentityProviders",
    "NeverOrganizationOrAccountChanges",
    "NeverDirectKmsGrants",
    "AssumeOnlyTheProofRoles",
    "PassOnlyTheBootstrapRole",
    "PassTheBootstrapRoleOnlyToEc2",
    "NeverIndirectExecution",
    "NeverSsmBeyondTheAmiParameter",
    "NeverChangeTheProofPrincipalsOrPolicies",
    "CreatedRolesCarryTheirBoundary",
    "OnlyTheApprovedRegion"
   ],
   "denies": {
    "NeverOtherEnvironmentNames": {
     "Effect": "Deny",
     "Action": "*",
     "Resource": [
      "arn:aws:s3:::nlw-<OTHER_ENV>-*",
      "arn:aws:s3:::nlw-<OTHER_ENV>-*/*",
