# O-6 DORMANT (ADR-038): the dataset settings docker-compose.datasets.yml
# interpolates. Copy to /opt/nlw/.env.datasets (root, 0600) ONLY with the
# separately authorized enablement. Placeholders only: never commit a real value.
# Not read by the rollout, which renders docker-compose.prod.yml +
# docker-compose.staging.yml alone.

# Dataset bucket and key (ADR-033; dataset-s3-provisioning.md).
NLW_DATASET_S3_BUCKET=nlw-staging-datasets-<ACCOUNT>-us-east-1
NLW_DATASET_S3_KMS_KEY_ARN=arn:aws:kms:us-east-1:<ACCOUNT>:key/<KEY_ID>
# External deletion-receipt log (ADR-034).
NLW_DELETION_LOG_BUCKET=nlw-staging-deletion-receipts-<ACCOUNT>-us-east-1

# Dataset runtimes: their roles stay NOLOGIN until enablement (rollout gate `fff`).
INGEST_DATABASE_URL=postgresql+psycopg://nlw_ingest:<PASSWORD>@postgres:5432/nlw
INGEST_DISPATCH_DATABASE_URL=postgresql+psycopg://nlw_ingest_dispatch:<PASSWORD>@postgres:5432/nlw
NLW_CTX_INGEST_KEY_ID=<INGEST_KEY_ID>
