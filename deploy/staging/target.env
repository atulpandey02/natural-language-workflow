# Staging/pilot host identity — the ONE reviewed source for the SSH address and
# the environment facts a release manifest needs (M12A-Prep §B/§M). Non-secret.
# Sourced by scripts/ops/lib/staging-target.sh, parsed by `python -m
# nlw.ops.rollout` and by the CI manifest generator (nlw.ops.release_manifest).
#
# The EC2 INSTANCE ID is the authoritative target: every deploy/verify script
# compares it against IMDSv2 on the connected host and STOPS on mismatch. The
# public IPv4 is only how SSH reaches the box; it is auto-assigned and can change
# after a STOP+START (a plain reboot keeps it). If it changes, update it HERE
# (and the sslip.io hostname + Supabase URL configuration) — nowhere else.
NLW_STAGING_ENVIRONMENT=staging
NLW_STAGING_INSTANCE_ID=i-0d1e65cdc9401dbb9
NLW_STAGING_REGION=us-east-1
NLW_STAGING_SSH_HOST=32.197.83.193
NLW_STAGING_SSH_USER=nlwops
NLW_STAGING_PUBLIC_HOSTNAME=32-197-83-193.sslip.io
# Host layout: releases are staged in <OPS_ROOT>/releases/<sha>; <OPS_ROOT>/current
# is the activation symlink and — since the first rollout completed — the ACTIVE
# checkout every phase reads, stops and clones from (the legacy /opt/nlw/app is
# kept only as a rollback artefact). Rollout state lives in <OPS_ROOT>/rollout.
NLW_STAGING_OPS_ROOT=/opt/nlw
NLW_STAGING_REMOTE_APP=/opt/nlw/current
NLW_STAGING_COMPOSE_PROJECT=app
# Where stage-release fetches the release SHA from (the reviewed repository; the
# active checkout's own origin is the legacy local clone chain).
NLW_STAGING_GIT_REMOTE=https://github.com/atulpandey02/natural-language-workflow.git
# Environment state the manifest generator records: the migration the target
# database is expected to be at BEFORE this rollout (verified live; mismatch =
# unknown state = stop). Update per rollout.
NLW_STAGING_CURRENT_REVISION=0020_schedule_authorization
# Operator Alertmanager authority (docs/ops/alerting.md): the receiver config, its
# credential files and the Compose override that mounts them live on the host
# OUTSIDE every release checkout. All three are required; preflight and every
# Alertmanager (re)creation fail closed without them. No credential value here.
NLW_STAGING_ALERTMANAGER_CONFIG=/opt/nlw/alertmanager/alertmanager.yml
NLW_STAGING_ALERTMANAGER_SECRETS_DIR=/opt/nlw/alertmanager.secrets
NLW_STAGING_COMPOSE_OVERRIDE=/opt/nlw/docker-compose.operator.yml
# Signed-context key ids (labels only — material lives in host key files and the
# ctx_keys registry). Unique per class; rotate the label with the key.
NLW_STAGING_KEY_ID_API=stg-api-2026-09
NLW_STAGING_KEY_ID_WORKER=stg-worker-2026-09
NLW_STAGING_KEY_ID_SCHEDULER=stg-scheduler-2026-09
# SSH private key path is operator-local and NOT recorded here; scripts default
# to ~/.ssh/nlw-staging-key.pem and honour NLW_STAGING_SSH_KEY / SSH_KEY.
