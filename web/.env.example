# Runtime public config (browser-safe; supplied at RUNTIME, not baked into the
# build — the Next server injects these into the document). One built image can
# therefore target any Supabase project by changing these values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Optional: overrides ONLY how the Next server reaches the SAME project (e.g. a
# private DNS name or host gateway). Leave unset to use SUPABASE_URL.
# SUPABASE_SERVER_URL=http://host.docker.internal:54321

# Server-only config (NEVER exposed to the browser):
NLW_API_URL=http://api:8000
WORKSPACE_COOKIE_SECRET=change-me-in-staging-32-bytes-min
