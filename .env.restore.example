# NLW guarded disaster-recovery restore — environment (PLACEHOLDERS ONLY).
#
# Copy to a root-only 0600 file on the FRESH recovery host and fill from your
# secret store. A restore is DESTRUCTIVE and must be run by a human following
# docs/runbooks/dr-fresh-host-restore.md. It refuses to run unless
# NLW_RESTORE_CONFIRM exactly equals NLW_RESTORE_TARGET_ID.

APP_ENV=production

# --- Encrypted repository (same repo the backups were written to) -----------
RESTIC_REPOSITORY=s3:https://s3.<region>.amazonaws.com/<your-bucket>/nlw
RESTIC_PASSWORD=<repository-encryption-passphrase>
AWS_ACCESS_KEY_ID=<access-key-id>
AWS_SECRET_ACCESS_KEY=<secret-access-key>
AWS_DEFAULT_REGION=<region>

# --- FRESH target database (owner/superuser; creates objects + grants) ------
# MUST be an empty, freshly-migrated-role-bootstrapped database. Restore asserts
# no runtime connections and an empty target before touching it.
NLW_RESTORE_DATABASE_URL=postgresql://nlw:<owner-password>@db:5432/nlw

# --- Which snapshot to restore ("latest" or an exact restic snapshot id) ----
NLW_RESTORE_SNAPSHOT=latest

# --- Destructive confirmation (fail-closed) ---------------------------------
# The exact target identity (e.g. the fresh Compose project or DB name) and the
# operator's explicit confirmation. They MUST match, or the restore refuses.
NLW_RESTORE_TARGET_ID=<exact-fresh-target-id>
NLW_RESTORE_CONFIRM=<must-equal-NLW_RESTORE_TARGET_ID>

# --- Ephemeral Redis to flush (never restore stale queue state) -------------
REDIS_URL=redis://redis:6379/0

# --- Validated temp dir for the transient decrypted dump (wiped, 0700) ------
NLW_RESTORE_WORK_DIR=/tmp/nlw-restore
