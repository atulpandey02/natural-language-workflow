# Production / real-VPS staging environment — EXAMPLE (placeholders only).
#
# Copy to .env.prod (git-ignored), fill in strong values, and restrict it:
#     cp .env.prod.example .env.prod
#     chmod 600 .env.prod
#     chmod 600 docker/worker.secrets.env   # if using connector secrets
#
# NEVER commit a real .env.prod. Compose does NOT auto-load .env.prod; every
# command must pass it explicitly, e.g.:
#     docker compose --env-file .env.prod \
#       -f docker-compose.prod.yml -f docker-compose.staging.yml config
#     docker compose --env-file .env.prod \
#       -f docker-compose.prod.yml -f docker-compose.staging.yml \
#       --profile migration run --rm migrate      # owner cred only in this service
#     docker compose --env-file .env.prod \
#       -f docker-compose.prod.yml -f docker-compose.staging.yml up -d
# (The same --env-file applies to config / pull / up / down / drills / restore.)
#
# The real VPS runs docker-compose.prod.yml + docker-compose.staging.yml ONLY.
# Do NOT include docker-compose.e2e.yml on a real VPS.

# --- PostgreSQL owner + role passwords -------------------------------------
# Generate each independently as cryptographically random, URL-safe values
# (high entropy, no DATABASE_URL escaping ambiguity):
#     openssl rand -hex 32
# Required: a fresh Postgres volume (00-roles.sh) and the prod compose fail
# without these. Rotating them here does NOT change an EXISTING role's password
# (that is an ALTER ROLE runbook: docs/runbooks/rotate-db-role-password.md).
POSTGRES_PASSWORD=
NLW_APP_DB_PASSWORD=
NLW_WORKER_DB_PASSWORD=
NLW_SCHEDULER_DB_PASSWORD=

# --- Per-role connection URLs ----------------------------------------------
# Each URL MUST embed ITS OWN role's password (URL-safe, as above):
#   API        -> nlw_app        (DATABASE_URL)
#   worker     -> nlw_worker     (WORKER_DATABASE_URL)
#   scheduler  -> nlw_scheduler  (SCHEDULER_DATABASE_URL)
#   migrations -> nlw (owner)    (DATABASE_MIGRATION_URL, uses POSTGRES_PASSWORD)
# There is NO fallback: worker/scheduler must use their own role in production.
DATABASE_URL=postgresql+psycopg://nlw_app:<NLW_APP_DB_PASSWORD>@postgres:5432/nlw
WORKER_DATABASE_URL=postgresql+psycopg://nlw_worker:<NLW_WORKER_DB_PASSWORD>@postgres:5432/nlw
SCHEDULER_DATABASE_URL=postgresql+psycopg://nlw_scheduler:<NLW_SCHEDULER_DB_PASSWORD>@postgres:5432/nlw
DATABASE_MIGRATION_URL=postgresql+psycopg://nlw:<POSTGRES_PASSWORD>@postgres:5432/nlw

# --- Redis (transport only) ------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Immutable images (GHCR digests; same digest staging -> production) -----
NLW_IMAGE=ghcr.io/<owner>/nlw@sha256:...
NLW_WEB_IMAGE=ghcr.io/<owner>/nlw/web@sha256:...

# --- Public ingress / TLS --------------------------------------------------
PUBLIC_HOSTNAME=staging.example.com
WORKSPACE_COOKIE_SECRET=

# --- Supabase (identity only; JWKS verification) ---------------------------
# Runtime public config (browser-safe; server-injected — see PR1). One image
# targets any project via these runtime values.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
# Optional: overrides only how the Next SERVER reaches the SAME project.
# SUPABASE_SERVER_URL=
# Optional explicit JWKS/issuer overrides (default derived from SUPABASE_URL):
# SUPABASE_JWKS_URL=
# SUPABASE_JWT_ISSUER=

# --- Natural-language planner LLM (API process ONLY) -----------------------
# The planner runs API-side; these reach ONLY the api service (never worker,
# scheduler, or web). This is PLATFORM configuration, not a tenant/connector
# secret.
#   - Provider 'stub' (default) needs NO key — deterministic CI/dev planner.
#   - Provider 'anthropic' REQUIRES NLW_LLM_API_KEY to be set.
# Add the real key MANUALLY on the host and NEVER commit it (keep .env.prod 600).
NLW_LLM_PROVIDER=anthropic
NLW_LLM_MODEL=claude-haiku-4-5-20251001
NLW_LLM_API_KEY=

# --- Rate limits (normal production values) --------------------------------
# RATE_LIMIT_PLANS_PER_MIN=20
# RATE_LIMIT_WRITES_PER_MIN=60

# --- DR recovery gate (API) -------------------------------------------------
# The API re-reads the authoritative recovery lock (dr_restore_events) on this
# short bounded cache; a cached ALLOWED goes stale (-> fail closed) after the TTL,
# and a running API re-locks/opens within it without a restart. Bounded query
# timeout applies to each refresh. Liveness is never gated.
# RECOVERY_GATE_TTL_S=5.0
# RECOVERY_GATE_QUERY_TIMEOUT_S=2.0
